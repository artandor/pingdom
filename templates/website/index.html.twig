{% extends 'base.html.twig' %}

{% block title %}Uptime Monitor{% endblock %}

{% block body %}
{{- turbo_stream_from('App\\Entity\\Website') -}}

{# ── Header ── #}
<header class="app-header">
    <a href="/" class="app-logo">
        <div class="logo-icon">
            <i class="bi bi-activity"></i>
        </div>
        Uptime Monitor
    </a>
    <span class="header-meta">
        <i class="bi bi-clock"></i>
        {{ "now"|date("d M Y  ·  H:i") }}
    </span>
</header>

{# ── Main content ── #}
<main class="container-fluid px-3 px-md-4 py-4">

    {# ── Stats row ── #}
    {{ include('website/_stats.html.twig') }}

    {# ── Monitor table ── #}
    <div class="monitor-card">
        <div class="monitor-card-header">
            <h1 class="monitor-card-title">
                <i class="bi bi-globe2 text-secondary"></i>
                Monitored Websites
            </h1>
            {% set total = websites|length %}
            {% if total > 0 %}
            <span class="date-none">{{ total }} site{{ total > 1 ? 's' : '' }}</span>
            {% endif %}
        </div>

        {% if websites is empty %}
        <div class="empty-state">
            <i class="bi bi-globe"></i>
            <p>No websites being monitored yet.</p>
        </div>
        {% else %}
        <div class="table-responsive">
            <table class="monitor-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Domain</th>
                        <th>Status</th>
                        <th>Response time</th>
                        <th>Fails</th>
                        <th>Last OK</th>
                        <th>Last alert</th>
                    </tr>
                </thead>
                <tbody id="monitor-tbody">
                {% for website in websites %}
                    {{ include('website/_row.html.twig') }}
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

</main>
{% endblock %}
